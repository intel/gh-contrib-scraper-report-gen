# Bandit configuration, read as YAML with `bandit -c .bandit -r .` (CI: .github/workflows/bandit.yml).
# Every Bandit test runs; CI fails on medium or high severity.
# To accept a finding, mark the line with `# nosec BXXX` and a reason, rather than skipping the test here.
exclude_dirs: ['.venv', 'venv']
